# ===== Fin de línea: scripts y config SIEMPRE LF (Linux/CI friendly) =====
*.sh           text eol=lf
Dockerfile     text eol=lf
*Caddyfile*    text eol=lf
*.service      text eol=lf

# YAML/propiedades/entornos (evitar CRLF en CI y compose)
*.yml          text eol=lf
*.yaml         text eol=lf
*.conf         text eol=lf
*.properties   text eol=lf
*.env          text eol=lf
*.env.sample   text eol=lf

# SQL (migraciones Flyway/Alembic)
*.sql          text eol=lf

# Código fuente: marcar como texto (Git gestiona EOL)
*.java         text
*.kt           text
*.py           text
*.ts           text
*.tsx          text
*.js           text
*.jsx          text
*.css          text
*.scss         text
*.md           text
*.json         text
*.csv          text

# Binarios (no tocar EOL)
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.jar          binary
*.zip          binary

# dockerize binario (si lo versionas)
backend/dockerize/** binary
