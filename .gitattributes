# Normalización por defecto
* text=auto

# ===== Fin de línea: scripts y config SIEMPRE LF (Linux/CI friendly) =====
*.sh           text eol=lf
*.bash         text eol=lf
Dockerfile     text eol=lf
Caddyfile      text eol=lf
*.service      text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.conf         text eol=lf
*.properties   text eol=lf
*.env          text eol=lf
*.env.sample   text eol=lf
*.sql          text eol=lf

# Código fuente como texto (Git gestiona EOL)
*.java         text
*.kt           text
*.py           text
*.ts           text
*.tsx          text
*.js           text
*.jsx          text
*.css          text
*.scss         text
*.md           text
*.json         text
*.csv          text

# Binarios (no tocar EOL)
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.jar          binary
*.zip          binary

