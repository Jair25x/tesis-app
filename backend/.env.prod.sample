# ==== JWT / S2S (rotar periódicamente) ====
JWT_SECRET=           # openssl rand -base64 48
S2S_JWT_SECRET=       # openssl rand -base64 48
PUBLIC_JWT_SECRET=    # igual que JWT_SECRET si solo firmas HMAC pública

# ==== Redis ====
REDIS_PASSWORD=       # openssl rand -hex 32

# ==== Passwords Postgres (únicos y fuertes) ====
POSTGRES_AUTH_PASSWORD=
POSTGRES_CONTENT_PASSWORD=
POSTGRES_PROGRESS_PASSWORD=
POSTGRES_CLASSROOM_PASSWORD=
POSTGRES_ASSESSMENT_PASSWORD=
POSTGRES_ADVISOR_PASSWORD=
POSTGRES_DUELS_PASSWORD=

# ==== Config Server / GitHub PAT (sólo lectura) ====
GITHUB_TOKEN=         # nuevo PAT con scope mínimo: repo:read (o equivalentemente read-only)

# ==== OpenAI ====
OPENAI_API_KEY=       # nuevo
OPENAI_EMBED_MODEL=text-embedding-3-small

# ==== Grafana ====
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# ==== URLs (prod) ====
FRONTEND_PUBLIC_URL=https://app.capimath.net.pe
GATEWAY_PUBLIC_URL=https://api.capimath.net.pe
ALLOWED_ORIGINS=https://app.capimath.net.pe

# ==== Servicios internos (no públicos) ====
CONFIG_SERVER_URL=http://config-service:8888
EUREKA_URL=http://eureka-server:8761/eureka/
ADMIN_MONITORING_URL=http://admin-monitoring-service:9090