# ==== TAGS publicados por CI (uno por servicio propio) ====
FRONTEND_TAG=prod-YYYYMMDD-HHMM
GATEWAY_TAG=prod-YYYYMMDD-HHMM
EUREKA_TAG=prod-YYYYMMDD-HHMM
CONFIG_TAG=prod-YYYYMMDD-HHMM
ADMIN_TAG=prod-YYYYMMDD-HHMM
AUTH_TAG=prod-YYYYMMDD-HHMM
CURRICULUM_TAG=prod-YYYYMMDD-HHMM
PROGRESS_TAG=prod-YYYYMMDD-HHMM
CLASSROOM_TAG=prod-YYYYMMDD-HHMM
ASSESSMENT_TAG=prod-YYYYMMDD-HHMM
AI_ADVISOR_TAG=prod-YYYYMMDD-HHMM
DUELS_TAG=prod-YYYYMMDD-HHMM

# ==== JWT / S2S (généralos de nuevo; 64-96 bytes) ====
# Ej: openssl rand -base64 64
JWT_SECRET=REEMPLAZA_POR_SECRETO_FUERTE
S2S_JWT_SECRET=REEMPLAZA_POR_SECRETO_FUERTE
PUBLIC_JWT_SECRET=${JWT_SECRET}

# ==== Redis (usa 32+ bytes, hex o base64) ====
# Ej: openssl rand -hex 32
REDIS_PASSWORD=REEMPLAZA_POR_SECRETO_FUERTE

# ==== Passwords Postgres (todas distintas y fuertes) ====
POSTGRES_AUTH_PASSWORD=REEMPLAZA
POSTGRES_CONTENT_PASSWORD=REEMPLAZA
POSTGRES_PROGRESS_PASSWORD=REEMPLAZA
POSTGRES_CLASSROOM_PASSWORD=REEMPLAZA
POSTGRES_ASSESSMENT_PASSWORD=REEMPLAZA
POSTGRES_ADVISOR_PASSWORD=REEMPLAZA
POSTGRES_DUELS_PASSWORD=REEMPLAZA

# ==== Config Server / GitHub PAT (read-only) ====
# Scope mínimo: contents:read (o repo read-only)
GITHUB_TOKEN=REEMPLAZA_POR_PAT_SOLO_LECTURA

# ==== OpenAI ====
OPENAI_API_KEY=REEMPLAZA
OPENAI_EMBED_MODEL=text-embedding-3-small

# ==== Grafana ====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REEMPLAZA

# ==== URLs (prod) ====
FRONTEND_PUBLIC_URL=https://app.capimath.net.pe
GATEWAY_PUBLIC_URL=https://api.capimath.net.pe
ALLOWED_ORIGINS=https://app.capimath.net.pe

# ==== Servicios internos (no públicos) ====
CONFIG_SERVER_URL=http://config-service:8888
EUREKA_URL=http://eureka-server:8761/eureka/
ADMIN_MONITORING_URL=http://admin-monitoring-service:9090
