# Example environment variables for backend services

# JWT secret for token signing
JWT_SECRET=change_me_secret_key

# OpenAI API key for AI features
OPENAI_API_KEY=your_openai_api_key

# PostgreSQL database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=tesisdb_auth

# GitHub token for Config Service access
GITHUB_TOKEN=your_github_token

# Spring profile to run
SPRING_PROFILES_ACTIVE=dev

# Eureka discovery server URL
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/

# Config Server URL
CONFIG_SERVER_URL=http://config-service:8888

# Spring Boot Admin client configuration
SPRING_BOOT_ADMIN_CLIENT_URL=http://admin-monitoring-service:9090
SPRING_BOOT_ADMIN_CLIENT_INSTANCE_METADATA_USER_NAME=admin
SPRING_BOOT_ADMIN_CLIENT_INSTANCE_METADATA_USER_PASSWORD=admin

# Database connection for Auth Service
SPRING_DATASOURCE_URL=jdbc:postgresql://auth-profile-db:5432/tesisdb_auth
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
