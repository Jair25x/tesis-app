}

# Redirección explícita HTTP -> HTTPS para cualquier host
http:// {
  redir https://{host}{uri} permanent
}

# --------- Frontend (app) ----------
app.capimath.net.pe {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:"
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy frontend:80
}

# --------- API (gateway) ----------
api.capimath.net.pe {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy "strict-origin-when-cross-origin"
    Access-Control-Expose-Headers "X-Request-Id"
  }

  reverse_proxy gateway-service:8080 {
    transport http {
      read_buffer   4096
      write_buffer  4096
      read_timeout  3700s
      write_timeout 3700s
      dial_timeout  5s
    }
  }
}

# --------- Admin (Spring Boot Admin) ----------
admin.capimath.net.pe {
  encode zstd gzip

  basic_auth /* {
    admin $2a$14$J7wTGpvYyfZgTfyfeVWwmuwsF3p.42zlF96fxQx.ZYUBgLJZsWjai
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy admin-monitoring-service:9090
}
